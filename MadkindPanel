local function SpawnPetal(parent)
    if not Settings.SakuraPetals then return end
    local petal = Instance.new("ImageLabel")
    local s = math.random(10, 18)
    petal.Size = UDim2.new(0, s, 0, s)
    petal.BackgroundTransparency = 1
    petal.Image = "rbxassetid://1316045217"
    petal.ImageColor3 = CurrentTheme().accent
    petal.ImageTransparency = 0.35
    petal.Position = UDim2.new(math.random(), 0, -0.1, 0)
    petal.Rotation = math.random(0, 360)
    petal.ZIndex = 2
    petal.Parent = parent
    local dur = math.random(4, 8)
    TweenService:Create(petal, TweenInfo.new(dur, Enum.EasingStyle.Linear), {
        Position = UDim2.new(petal.Position.X.Scale + (math.random() - 0.5) * 0.2, 0, 1.1, 0),
        Rotation = math.random(360, 900),
    }):Play()
    task.delay(dur + 0.1, function() if petal and petal.Parent then petal:Destroy() end end)
end

local function Notify(title, text, dur)
