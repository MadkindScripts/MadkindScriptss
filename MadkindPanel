local function R_Accent(el, p) table.insert(AccentList, {el=el, p=p}) el[p] = CurrentTheme().accent end
local function R_Panel(el, p) table.insert(PanelList, {el=el, p=p}) el[p] = CurrentTheme().panel end
local function R_Text(el, p) table.insert(TextList, {el=el, p=p}) el[p] = CurrentTheme().text end

local function ApplyTheme()
    local th = CurrentTheme()
    for _, it in pairs(AccentList) do pcall(function() it.el[it.p] = th.accent end) end
    for _, it in pairs(PanelList) do pcall(function() it.el[it.p] = th.panel end) end
    for _, it in pairs(TextList) do pcall(function() it.el[it.p] = th.text end) end
    MainFrame.BackgroundColor3 = th.background
    TitleBar.BackgroundColor3 = th.panel
    TitleFix.BackgroundColor3 = th.panel
    MainStroke.Color = th.accent
    Logo.TextColor3 = th.accent
    Title.TextColor3 = th.text
    ScrollFrame.ScrollBarImageColor3 = th.accent
    ToggleBtn.TextColor3 = th.accent
    ToggleBtn.BackgroundColor3 = th.background
end

